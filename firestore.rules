rules_version = '2';
service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function maxSingleAward() {
    return 100000;
  }

  match /databases/{database}/documents {
    match /apps/greenpassport/users/{userId} {
      allow read: if request.auth != null;
      allow delete: if false;

      allow create: if isOwner(userId) &&
        request.resource.data.get('availablePoints', 0) is int &&
        request.resource.data.get('availablePoints', 0) >= 0 &&
        request.resource.data.get('availablePoints', 0) <= maxSingleAward() &&
        request.resource.data.get('lifetimeXp', 0) is int &&
        request.resource.data.get('lifetimeXp', 0) >= 0 &&
        request.resource.data.get('lifetimeXp', 0) <= maxSingleAward();

      allow update: if isOwner(userId) &&
        request.resource.data.get('availablePoints', 0) is int &&
        request.resource.data.get('availablePoints', 0) >= 0 &&
        request.resource.data.get('availablePoints', 0) <= resource.data.get('availablePoints', 0) + maxSingleAward() &&
        request.resource.data.get('lifetimeXp', 0) is int &&
        request.resource.data.get('lifetimeXp', 0) >= resource.data.get('lifetimeXp', 0) &&
        request.resource.data.get('lifetimeXp', 0) <= resource.data.get('lifetimeXp', 0) + maxSingleAward();
    }

    match /apps/greenpassport/taskProgress/{progressId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/purchases/{purchaseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/eventRegistrations/{registrationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/ecoTipReads/{readId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/surveyAnswers/{answerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/favoriteTasks/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /apps/greenpassport/bookmarkedTips/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /apps/greenpassport/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    match /apps/greenpassport/chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/{collection}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
