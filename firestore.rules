rules_version = '2';
service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  function isAdmin() {
    return request.auth != null &&
      exists(/databases/(default)/documents/apps/greenpassport/admins/$(request.auth.uid));
  }

  function staffRole() {
    let adminPath = /databases/(default)/documents/apps/greenpassport/admins/$(request.auth.uid);
    return exists(adminPath) ? get(adminPath).data.get('role', 'MODERATOR') : null;
  }

  function isEditor() {
    return request.auth != null && staffRole() in ['SUPER_ADMIN', 'EDITOR'];
  }

  function isStampedByEditor() {
    return isEditor() &&
      request.resource.data.updatedBy == request.auth.uid &&
      request.resource.data.updatedAtEpochMillis is int;
  }

  function serverCounters() {
    return ['issuedCount', 'usedCount', 'poolAvailableCount', 'selfMarkedCount'];
  }

  function isContentCollection(collection) {
    return collection in ['tasks', 'events', 'shopItems', 'ecoTips', 'mapPoints', 'surveys', 'games', 'partners'];
  }

  function isClosedCollection(collection) {
    return collection in [
      'taskSecrets', 'admins', 'reports', 'taskSubmissions', 'pointsLedger', 'taskProgress', 'purchases',
      'ecoTipReads', 'eventSecrets', 'eventAttendance', 'chats', 'partnerUsers', 'auditLog',
    ];
  }

  function isOwnerOrAdmin(data) {
    return request.auth != null && (data.userId == request.auth.uid || isAdmin());
  }

  function keepsPoints() {
    return !request.resource.data.diff(resource.data).affectedKeys()
      .hasAny(['availablePoints', 'lifetimeXp', 'streak', 'profileBonusAwarded']);
  }

  function hasNoPoints(data) {
    return data.get('availablePoints', 0) == 0 && data.get('lifetimeXp', 0) == 0 &&
      !('streak' in data) && !('profileBonusAwarded' in data);
  }

  function hasBannedWords(text) {
    return text.matches('(?is).*(хуй|хуя|пизд|бляд|блят|еблан|мудак|мудил|пидор|залуп|шлюх|гандон|гондон|fuck|cunt|nigger|faggot).*');
  }

  function isCleanText(text, maxLength) {
    return text is string && text.size() > 0 && text.size() <= maxLength && !hasBannedWords(text);
  }

  function isCleanOptionalText(data, field, maxLength) {
    return !(field in data) || data[field] == null || isCleanText(data[field], maxLength);
  }

  function isValidSubmission(data) {
    return data.userId == request.auth.uid &&
      data.status == 'PENDING' &&
      data.photoPath is string &&
      data.photoPath.matches('greenpassport/submissions/' + request.auth.uid + '/[A-Za-z0-9_-]+[.]jpg') &&
      data.createdAtEpochMillis is int &&
      isCleanOptionalText(data, 'userName', 61);
  }

  function isJoining() {
    return request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
      resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0;
  }

  function isLeaving() {
    return resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
      request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0;
  }

  function isGroupMember(database, groupId) {
    return request.auth.uid in
      get(/databases/$(database)/documents/apps/greenpassport/groups/$(groupId)).data.memberIds;
  }

  function hasCleanProfileNames(data) {
    return isCleanOptionalText(data, 'firstName', 30) && isCleanOptionalText(data, 'lastName', 30);
  }

  match /databases/{database}/documents {
    match /apps/greenpassport/users/{userId} {
      allow read: if request.auth != null;
      allow delete: if false;

      allow create: if isOwner(userId) && hasCleanProfileNames(request.resource.data) &&
        hasNoPoints(request.resource.data);

      allow update: if isOwner(userId) && hasCleanProfileNames(request.resource.data) && keepsPoints();
    }

    match /apps/greenpassport/taskProgress/{progressId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow write: if false;
    }

    match /apps/greenpassport/purchases/{purchaseId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow write: if false;
    }

    match /apps/greenpassport/pointsLedger/{entryId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow write: if false;
    }

    match /apps/greenpassport/admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /apps/greenpassport/taskSecrets/{taskId} {
      allow read, write: if false;
    }

    match /apps/greenpassport/eventSecrets/{eventId} {
      allow read, write: if false;
    }

    match /apps/greenpassport/eventAttendance/{attendanceId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow write: if false;
    }

    match /apps/greenpassport/taskSubmissions/{submissionId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow create: if request.auth != null &&
        submissionId == request.auth.uid + '_' + request.resource.data.taskId &&
        isValidSubmission(request.resource.data) &&
        get(/databases/$(database)/documents/apps/greenpassport/tasks/$(request.resource.data.taskId)).data.get('verification', 'SELF') == 'PHOTO';
      allow update: if request.auth != null && resource.data.userId == request.auth.uid &&
        resource.data.status == 'REJECTED' &&
        request.resource.data.taskId == resource.data.taskId &&
        isValidSubmission(request.resource.data);
      allow delete: if false;
    }

    match /apps/greenpassport/reports/{reportId} {
      allow read: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.reporterId == request.auth.uid &&
        reportId == request.resource.data.postId + '_' + request.auth.uid &&
        request.resource.data.reason in ['OFFENSIVE', 'SPAM', 'INAPPROPRIATE_IMAGE', 'OTHER'];
      allow update, delete: if false;
    }

    match /apps/greenpassport/eventRegistrations/{registrationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/ecoTipReads/{readId} {
      allow read: if isOwnerOrAdmin(resource.data);
      allow write: if false;
    }

    match /apps/greenpassport/feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid &&
        (request.resource.data.message == '' || isCleanText(request.resource.data.message, 2000));
      allow update, delete: if false;
    }

    match /apps/greenpassport/surveyAnswers/{answerId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /apps/greenpassport/favoriteTasks/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /apps/greenpassport/bookmarkedTips/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /apps/greenpassport/posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid &&
        isCleanText(request.resource.data.text, 2000) &&
        isCleanOptionalText(request.resource.data, 'authorName', 61);
      allow update, delete: if false;
    }

    match /apps/greenpassport/groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isCleanText(request.resource.data.name, 60) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.createdAtEpochMillis is int &&
        request.resource.data.inviteCode is string && request.resource.data.inviteCode.matches('[A-Z2-9]{6}');
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
        (isJoining() || isLeaving());
      allow delete: if false;
    }

    match /apps/greenpassport/chats/{groupId}/messages/{messageId} {
      allow read: if request.auth != null && isGroupMember(database, groupId);
      allow create: if request.auth != null && isGroupMember(database, groupId) &&
        request.resource.data.senderId == request.auth.uid &&
        isCleanText(request.resource.data.text, 2000) &&
        isCleanOptionalText(request.resource.data, 'senderName', 61) &&
        request.resource.data.createdAtEpochMillis is int;
      allow update, delete: if false;
    }

    match /apps/greenpassport/partnerUsers/{uid} {
      allow read: if isOwner(uid) || isEditor();
      allow write: if false;
    }

    match /apps/greenpassport/auditLog/{entryId} {
      allow read: if isEditor();
      allow write: if false;
    }

    match /apps/greenpassport/{collection}/{docId} {
      allow read: if request.auth != null && !isClosedCollection(collection);
      allow create: if isContentCollection(collection) && isStampedByEditor() &&
        !request.resource.data.keys().hasAny(serverCounters());
      allow update: if isContentCollection(collection) && isStampedByEditor() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverCounters());
      allow delete: if isContentCollection(collection) && isEditor();
    }

    match /apps/greenpassport/{collection}/{docId}/{subcollection}/{rest=**} {
      allow read: if request.auth != null && !isClosedCollection(collection) && subcollection != 'codePool';
      allow write: if false;
    }
  }
}
