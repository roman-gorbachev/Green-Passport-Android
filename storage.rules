rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/apps/greenpassport/admins/$(request.auth.uid));
    }

    match /greenpassport/submissions/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow update, delete: if false;
    }

    function isEditor() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/apps/greenpassport/admins/$(request.auth.uid)).data
          .get('role', 'MODERATOR') in ['SUPER_ADMIN', 'EDITOR'];
    }

    match /greenpassport/content/{kind}/{entityId}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isEditor() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isEditor();
    }

    match /greenpassport/{allPaths=**} {
      allow read: if request.auth != null && !allPaths.matches('submissions/.*');
      allow write: if false;
    }
  }
}
